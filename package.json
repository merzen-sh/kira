{
  "name": "kira",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter @kira/dashboard build",
    "gen:api-types": "bun run --filter @kira/api-types gen",
    "check:api-types": "bun run --filter @kira/api-types check",
    "typecheck": "bun run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
