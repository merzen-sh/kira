#!/usr/bin/env bash
# Verify Rust formatting and lints before committing.
#
# The hook is read-only: it never formats, stages, or stashes files, so staged,
# unstaged, partially staged, and untracked files are left exactly as they are.
set -euo pipefail

# Nothing staged: allow empty commits without running the full gate.
if git diff --cached --quiet; then
    exit 0
fi

cargo fmt --all -- --check
cargo clippy --workspace --all-targets --all-features -- -D warnings
cargo clippy -p kira --no-default-features -- -D warnings
